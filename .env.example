# Life OS Server Environment Template
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@your-cluster.mongodb.net/lifeOsDB?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
NODE_ENV=production

# Client origin for CORS (comma-separated if multiple, e.g. https://your-client-domain.vercel.app,http://localhost:5173)
CLIENT_ORIGIN=https://your-client-domain.vercel.app

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
